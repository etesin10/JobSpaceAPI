{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "locations": {
          "description": "Any of these (OR)",
          "items": {
            "$ref": "#/$defs/LocationConstraint"
          },
          "title": "Locations",
          "type": "array"
        },
        "work_mode": {
          "items": {
            "enum": [
              "remote",
              "hybrid",
              "onsite"
            ],
            "type": "string"
          },
          "title": "Work Mode",
          "type": "array"
        },
        "remote_eligibility": {
          "description": "For remote roles: countries (ISO) or blocs (LATAM, NA, EU, EMEA, APAC, GLOBAL) the role must accept",
          "items": {
            "type": "string"
          },
          "title": "Remote Eligibility",
          "type": "array"
        },
        "employment_type": {
          "description": "Empty = any",
          "items": {
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "temporary",
              "internship",
              "freelance",
              "seasonal"
            ],
            "type": "string"
          },
          "title": "Employment Type",
          "type": "array"
        },
        "seniority": {
          "description": "Empty = any",
          "items": {
            "enum": [
              "intern",
              "entry",
              "junior",
              "mid",
              "senior",
              "lead",
              "manager",
              "director",
              "executive"
            ],
            "type": "string"
          },
          "title": "Seniority",
          "type": "array"
        },
        "salary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Salary"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Floor: roles with known max below salary.min are rejected"
        },
        "sponsorship": {
          "$ref": "#/$defs/SponsorshipConstraint"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/LanguageConstraint"
          },
          "title": "Languages",
          "type": "array"
        },
        "posted_within_days": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 30,
          "title": "Posted Within Days"
        },
        "exclude_companies": {
          "description": "Domains or names to never include",
          "items": {
            "type": "string"
          },
          "title": "Exclude Companies",
          "type": "array"
        },
        "include_unknown": {
          "default": true,
          "description": "Keep roles whose value is unknown (e.g. no salary published)",
          "title": "Include Unknown",
          "type": "boolean"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "LanguageConstraint": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "examples": [
            "en",
            "es",
            "fr"
          ],
          "title": "Code",
          "type": "string"
        },
        "min": {
          "default": "B2",
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            "native"
          ],
          "title": "Min",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "LanguageConstraint",
      "type": "object"
    },
    "LocationConstraint": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "examples": [
            "CA",
            "MX",
            "US"
          ],
          "title": "Country",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "examples": [
                "CA-ON",
                "MX-NLE",
                "US-TX"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "radius_km": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius Km"
        }
      },
      "required": [
        "country"
      ],
      "title": "LocationConstraint",
      "type": "object"
    },
    "OccupationCode": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "ISCO-08",
            "NOC-2021",
            "SOC-2018",
            "ONET",
            "SINCO-2019",
            "ESCO",
            "OTHER"
          ],
          "title": "System",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "title": "OccupationCode",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "title",
            "description",
            "skills",
            "company",
            "company_domain",
            "industry",
            "country",
            "region",
            "city",
            "work_mode",
            "employment_type",
            "seniority",
            "salary_min",
            "salary_max",
            "salary_currency",
            "posted_days_ago",
            "languages",
            "source",
            "sponsorship"
          ],
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "nin",
            "any",
            "all",
            "none",
            "contains",
            "not_contains",
            "prefix",
            "regex",
            "gte",
            "lte",
            "between",
            "exists",
            "within_km"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "weight": {
          "default": 1.0,
          "description": "Only used by `should` rules",
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Rules": {
      "additionalProperties": false,
      "properties": {
        "must": {
          "description": "All must match or the role is rejected",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Must",
          "type": "array"
        },
        "should": {
          "description": "Each match adds its weight to the rules score",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Should",
          "type": "array"
        },
        "must_not": {
          "description": "Any match rejects the role",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Must Not",
          "type": "array"
        }
      },
      "title": "Rules",
      "type": "object"
    },
    "Salary": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "currency": {
          "anyOf": [
            {
              "examples": [
                "CAD",
                "MXN",
                "USD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "period": {
          "default": "year",
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "title": "Salary",
      "type": "object"
    },
    "Scoring": {
      "additionalProperties": false,
      "properties": {
        "weights": {
          "$ref": "#/$defs/ScoringWeights"
        },
        "min_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override matching.min_score",
          "title": "Min Score"
        }
      },
      "title": "Scoring",
      "type": "object"
    },
    "ScoringWeights": {
      "additionalProperties": false,
      "properties": {
        "skills": {
          "default": 0.6,
          "minimum": 0,
          "title": "Skills",
          "type": "number"
        },
        "rules": {
          "default": 0.25,
          "minimum": 0,
          "title": "Rules",
          "type": "number"
        },
        "title": {
          "default": 0.15,
          "minimum": 0,
          "title": "Title",
          "type": "number"
        }
      },
      "title": "ScoringWeights",
      "type": "object"
    },
    "SearchQuery": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "country": {
          "anyOf": [
            {
              "examples": [
                "CA",
                "MX",
                "US"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "sources": {
          "description": "Empty = all enabled",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "purpose": {
          "default": "roles",
          "enum": [
            "roles",
            "companies",
            "contacts"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "yield_total": {
          "default": 0,
          "title": "Yield Total",
          "type": "integer"
        },
        "yield_matched": {
          "default": 0,
          "title": "Yield Matched",
          "type": "integer"
        },
        "last_run_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "SearchQuery",
      "type": "object"
    },
    "SearchStrategy": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": 0,
          "title": "Version",
          "type": "integer"
        },
        "updated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/SearchQuery"
          },
          "title": "Queries",
          "type": "array"
        },
        "sources": {
          "description": "Preferred sources; empty = all enabled",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "SearchStrategy",
      "type": "object"
    },
    "SponsorshipConstraint": {
      "additionalProperties": false,
      "properties": {
        "need": {
          "default": "not_required",
          "enum": [
            "not_required",
            "preferred",
            "required"
          ],
          "title": "Need",
          "type": "string"
        },
        "programs": {
          "items": {
            "enum": [
              "CA_LMIA",
              "CA_GTS",
              "CA_IEC",
              "CA_CUSMA",
              "US_H1B",
              "US_TN",
              "US_L1",
              "US_O1",
              "US_GREEN_CARD",
              "UK_SKILLED_WORKER",
              "MX_WORK_VISA",
              "EU_BLUE_CARD",
              "AU_TSS",
              "OTHER"
            ],
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        }
      },
      "title": "SponsorshipConstraint",
      "type": "object"
    },
    "Targets": {
      "additionalProperties": false,
      "properties": {
        "occupations": {
          "items": {
            "$ref": "#/$defs/OccupationCode"
          },
          "title": "Occupations",
          "type": "array"
        },
        "titles": {
          "description": "Job titles in every language you accept",
          "items": {
            "type": "string"
          },
          "title": "Titles",
          "type": "array"
        },
        "activities": {
          "description": "What you want to do day to day",
          "items": {
            "type": "string"
          },
          "title": "Activities",
          "type": "array"
        },
        "industries": {
          "description": "NAICS codes or names",
          "items": {
            "type": "string"
          },
          "title": "Industries",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "title": "Targets",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "targets": {
      "$ref": "#/$defs/Targets"
    },
    "rules": {
      "$ref": "#/$defs/Rules"
    },
    "scoring": {
      "$ref": "#/$defs/Scoring"
    },
    "search_strategy": {
      "$ref": "#/$defs/SearchStrategy"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "name"
  ],
  "title": "Criteria",
  "type": "object"
}
